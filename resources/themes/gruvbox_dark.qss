/* GRUVBOX DARK THEME */

QMainWindow, QDialog, QWidget {
    background-color: #282828;
    color: #ebdbb2;
}

QLabel {
    background-color: transparent;
    color: #ebdbb2;
}
QLabel#loginError {
    color: #d32f2f;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #3c3836;
}

QTabBar::tab {
    background: #3c3836;
    padding: 8px 12px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #ebdbb2;
}

QTabBar::tab:selected {
    background: #504945;
    border-bottom: 2px solid #d79921;
}

/* GroupBox */
QGroupBox {
    border: 1px solid #3c3836;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #3c3836;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #d79921;
}

/* Inputs */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #1d2021;
    border: 1px solid #504945;
    color: #ebdbb2;
    padding: 4px 6px;
    border-radius: 3px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #d79921;
}

/* Popup */
QComboBox QAbstractItemView {
    background-color: #1d2021;
    border: 1px solid #504945;
    selection-background-color: #d79921;
    selection-color: #282828;
}

/* Buttons */
QPushButton {
    background-color: #504945;
    border: 1px solid #665c54;
    border-radius: 4px;
    padding: 6px 10px;
    color: #ebdbb2;
}

QPushButton:hover {
    background-color: #665c54;
}

QPushButton:pressed {
    background-color: #3c3836;
    border: 1px solid #d79921;
}

QPushButton:disabled {
    background-color: #3c3836;
    color: #928374;
}

/* Tables */
QHeaderView::section {
    background-color: #3c3836;
    color: #ebdbb2;
    padding: 4px;
    border: 1px solid #1d2021;
}

QTableWidget {
    gridline-color: #3c3836;
    background-color: #282828;
    alternate-background-color: #32302f;
    selection-background-color: #d79921;
    selection-color: #282828;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #282828;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #504945;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #665c54;
}

QScrollBar:horizontal {
    background: #282828;
    height: 12px;
}

QScrollBar::handle:horizontal {
    background: #504945;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #665c54;
}
