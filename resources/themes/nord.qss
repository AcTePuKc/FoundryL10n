/* NORD THEME */

QMainWindow, QDialog, QWidget {
    background-color: #2e3440;
    color: #d8dee9;
}

QLabel {
    background-color: transparent;
}

/* Tabs */
QTabWidget::pane { 
    border: 1px solid #3b4252;
}

QTabBar::tab {
    background: #3b4252;
    padding: 8px 12px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #eceff4;
}

QTabBar::tab:selected {
    background: #4c566a;
    border-bottom: 2px solid #88c0d0;
}

/* GroupBox */
QGroupBox {
    border: 1px solid #3b4252;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #3b4252;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #eceff4;
}

/* Inputs */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #434c5e;
    border: 1px solid #4c566a;
    color: #eceff4;
    padding: 4px 6px;
    border-radius: 3px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #88c0d0;
}

/* ComboBox popup */
QComboBox QAbstractItemView {
    background-color: #3b4252;
    border: 1px solid #4c566a;
    selection-background-color: #88c0d0;
    selection-color: #2e3440;
}

/* Buttons */
QPushButton {
    background-color: #4c566a;
    border: 1px solid #5e6d83;
    border-radius: 4px;
    padding: 6px 10px;
    color: #eceff4;
}

QPushButton:hover {
    background-color: #5e6d83;
}

QPushButton:pressed {
    background-color: #434c5e;
    border: 1px solid #81a1c1;
}

QPushButton:disabled {
    background-color: #3b4252;
    color: #7d8896;
    border: 1px solid #2e3440;
}

/* Tables */
QHeaderView::section {
    background-color: #3b4252;
    color: #eceff4;
    padding: 4px;
    border: 1px solid #2e3440;
}

QTableWidget {
    gridline-color: #3b4252;
    background-color: #2e3440;
    alternate-background-color: #434c5e;
    selection-background-color: #88c0d0;
    selection-color: #2e3440;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #2e3440;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #4c566a;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #5e6d83;
}

QScrollBar:horizontal {
    background: #2e3440;
    height: 12px;
}

QScrollBar::handle:horizontal {
    background: #4c566a;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #5e6d83;
}
