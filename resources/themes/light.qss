/* Base background & text */
QMainWindow, QDialog, QWidget {
    background-color: #f0f0f0;
    color: #202020;
}

/* Labels should never draw boxes */
QLabel {
    background-color: transparent;
}
QLabel#loginError {
    color: #d32f2f;
}

/* Tabs */
QTabWidget::pane { 
    border: 1px solid #c0c0c0; 
}

QTabBar::tab {
    background: #e0e0e0;
    padding: 8px 12px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #202020;
}

QTabBar::tab:selected {
    background: #ffffff;
    border-bottom: 2px solid #007acc;
}

/* Group boxes */
QGroupBox {
    border: 1px solid #c0c0c0;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #f7f7f7;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #202020;
}

/* Inputs */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    color: #202020;
    padding: 4px 6px;
    border-radius: 3px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #007acc;
}

/* ComboBox popup */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    selection-background-color: #007acc;
    selection-color: #ffffff;
}

/* Buttons */
QPushButton {
    background-color: #e0e0e0;
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    padding: 6px 10px;
    color: #202020;
}

QPushButton:hover {
    background-color: #e8e8e8;
}

QPushButton:pressed {
    background-color: #d0d0d0;
    border: 1px solid #888888;
}

QPushButton:disabled {
    background-color: #f0f0f0;
    color: #aaaaaa;
    border: 1px solid #dddddd;
}

/* Tables & headers */
QHeaderView::section {
    background-color: #e0e0e0;
    color: #202020;
    padding: 4px;
    border: 1px solid #c0c0c0;
}

QTableWidget {
    gridline-color: #c0c0c0;
    background-color: #ffffff;
    alternate-background-color: #f5f5f5;
    selection-background-color: #007acc;
    selection-color: #ffffff;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #f0f0f0;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #d0d0d0;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #c4c4c4;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #f0f0f0;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #d0d0d0;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #c4c4c4;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
