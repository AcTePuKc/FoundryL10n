/* CATPPUCCIN MOCHA THEME */

QMainWindow, QDialog, QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

QLabel {
    background-color: transparent;
    color: #cdd6f4;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #45475a;
}

QTabBar::tab {
    background: #313244;
    padding: 8px 12px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #cdd6f4;
}

QTabBar::tab:selected {
    background: #45475a;
    border-bottom: 2px solid #89b4fa;
}

/* GroupBox */
QGroupBox {
    border: 1px solid #45475a;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #313244;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #89b4fa;
}

/* Inputs */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #181825;
    border: 1px solid #45475a;
    color: #cdd6f4;
    padding: 4px 6px;
    border-radius: 3px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #89b4fa;
}

/* Popup */
QComboBox QAbstractItemView {
    background-color: #181825;
    border: 1px solid #45475a;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
}

/* Buttons */
QPushButton {
    background-color: #45475a;
    border: 1px solid #585b70;
    border-radius: 4px;
    padding: 6px 10px;
    color: #cdd6f4;
}

QPushButton:hover {
    background-color: #585b70;
}

QPushButton:pressed {
    background-color: #313244;
    border: 1px solid #89b4fa;
}

QPushButton:disabled {
    background-color: #313244;
    color: #6c7086;
}

/* Tables */
QHeaderView::section {
    background-color: #45475a;
    color: #cdd6f4;
    padding: 4px;
    border: 1px solid #313244;
}

QTableWidget {
    gridline-color: #45475a;
    background-color: #1e1e2e;
    alternate-background-color: #313244;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #1e1e2e;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #45475a;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #585b70;
}

QScrollBar:horizontal {
    background: #1e1e2e;
    height: 12px;
}

QScrollBar::handle:horizontal {
    background: #45475a;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #585b70;
}
