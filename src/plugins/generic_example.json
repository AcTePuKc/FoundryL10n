{
  "metadata": {
    "id": "generic-poc",
    "name": "Generic POC Provider",
    "version": "1.0.0",
    "homepage": "https://example.com",
    "description": "Official proof-of-concept provider for the generic API workflow."
  },
  "auth": {
    "type": "bearer",
    "token_header": "Authorization",
    "token_prefix": "Bearer "
  },
  "endpoints": {
    "base_url": "https://example.com",
    "fetch_segments": {
      "method": "GET",
      "path": "/api/games/{game_id}/segments",
      "query": {
        "page": "{page}"
      }
    },
    "submit_suggestion": {
      "method": "POST",
      "path": "/api/games/{game_id}/segments/{segment_id}/suggestions"
    }
  },
  "tsv": {
    "columns": [
      "key",
      "source",
      "translation",
      "notes"
    ],
    "key_field": "segment_id"
  }
}
