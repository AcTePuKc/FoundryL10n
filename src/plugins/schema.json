{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FoundryL10n Provider Plugin",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string" },
        "version": { "type": "string" },
        "homepage": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "base_url": { "type": "string", "format": "uri" }
      },
      "required": ["name", "id", "version"]
    },
    "auth": {
      "type": "object",
      "properties": {
        "type": { "enum": ["bearer", "basic", "oauth2", "Bearer", "Basic", "OAuth2"] },
        "login_endpoint": { "type": "string" },
        "token_path": { "type": "string", "description": "JSON path to the token in the response" },
        "token_header": { "type": "string" },
        "token_prefix": { "type": "string" }
      },
      "required": ["type"]
    },
    "endpoints": {
      "type": "object",
      "properties": {
        "base_url": { "type": "string", "format": "uri" },
        "fetch_projects": { "oneOf": [
          { "type": "string" },
          { "$ref": "#/definitions/endpoint" }
        ] },
        "fetch_segments": { "oneOf": [
          { "type": "string", "description": "Expects placeholders like {project_id} and {page}" },
          { "$ref": "#/definitions/endpoint" }
        ] },
        "submit_suggestion": { "oneOf": [
          { "type": "string", "description": "Expects placeholder like {segment_id}" },
          { "$ref": "#/definitions/endpoint" }
        ] }
      },
      "required": ["base_url", "fetch_segments", "submit_suggestion"]
    },
    "mapping": {
      "type": "object",
      "properties": {
        "source_text": { "type": "string", "default": "source" },
        "target_text": { "type": "string", "default": "current_translation" },
        "segment_id": { "type": "string", "default": "segment_id" }
      }
    },
    "custom_fields": {
      "type": "array",
      "items": { "$ref": "#/definitions/custom_field" }
    },
    "tsv": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "key_field": { "type": "string" }
      },
      "required": ["columns", "key_field"]
    }
  },
  "required": ["metadata", "auth", "endpoints"],
  "definitions": {
    "endpoint": {
      "type": "object",
      "properties": {
        "method": { "type": "string" },
        "path": { "type": "string" },
        "query": { "type": "object" },
        "headers": { "type": "object" },
        "body": { "type": "object" }
      },
      "required": ["method", "path"]
    },
    "custom_field": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "default": { "type": ["string", "number", "integer", "boolean", "object", "array", "null"] },
        "validation": {
          "type": "object",
          "properties": {
            "min_length": { "type": "integer", "minimum": 0 },
            "max_length": { "type": "integer", "minimum": 0 },
            "pattern": { "type": "string" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number" },
            "options": {
              "type": "array",
              "items": { "type": "string" }
            },
            "placeholder": { "type": "string" },
            "help": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "required": ["id", "label", "type"]
    }
  }
}
